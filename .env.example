NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Do not expose this through NEXT_PUBLIC_ variables.
# Not required for the current implementation unless a future server-only admin workflow needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side Clio Manage OAuth integration for completed intake submissions.
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=https://www.transferondeathdeedtexas.com/api/clio/callback
CLIO_CONNECT_SECRET=
CLIO_REFRESH_TOKEN=
CLIO_MANAGE_BASE_URL=https://app.clio.com

# Legacy Clio Grow fallback. Used only when CLIO_REFRESH_TOKEN is not configured.
CLIO_GROW_API_TOKEN=
CLIO_GROW_API_BASE_URL=
CLIO_GROW_INBOX_LEADS_URL=
NEXT_PUBLIC_SITE_URL=
